{
  "expo": {
    "name": "lich-am-app",
    "slug": "lich-am-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.lichamapp",
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7A2E2E"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.lightd.lichamapp",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "lichamapp",
    "plugins": [
      "expo-router"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#7A2E2E",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc1e6485-95a0-40dd-af1f-da4d50cf4aec"
      }
    }
  }
}