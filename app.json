{
  "expo": {
    "name": "lich-am-app",
    "slug": "lich-am-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.lichamapp",
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7A2E2E"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.lightd.lichamapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần quyền truy cập thư viện ảnh để bạn chọn ảnh đại diện cho thành viên gia phả và thêm ảnh vào phòng trưng bày.",
        "NSFaceIDUsageDescription": "Dùng Face ID để đăng nhập nhanh mà không cần nhập lại mật khẩu."
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "lichamapp",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#7A2E2E"
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#7A2E2E",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc1e6485-95a0-40dd-af1f-da4d50cf4aec"
      }
    }
  }
}